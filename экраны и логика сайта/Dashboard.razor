@namespace MatResurs.Pages
@* Главный экран на C#: здесь находятся разделы материалов, движения и отчётов. *@
@inject IJSRuntime Js
@using System.Text

<div class="app-shell">
  @* Горизонтальное текстовое меню для перехода между разделами. *@
  <header class="site-header">
    <div class="header-inner">
      <div class="brand"><span class="brand-icon">▦</span><div><b>МатРесурс</b><small>Учёт материалов</small></div></div>
      <nav class="side-nav" aria-label="Разделы системы">
        <button type="button" class="@(tab == "home" ? "selected" : "")" @onclick='() => Go("home")'>Главная</button>
        <button type="button" class="@(tab == "materials" ? "selected" : "")" @onclick='() => Go("materials")'>Материалы</button>
        <button type="button" class="@(tab == "operation" ? "selected" : "")" @onclick='() => Go("operation")'>Приход и расход</button>
        <button type="button" class="@(tab == "history" ? "selected" : "")" @onclick='() => Go("history")'>История</button>
        <button type="button" class="@(tab == "report" ? "selected" : "")" @onclick='() => Go("report")'>Отчёт</button>
      </nav>
    </div>
  </header>

  <main class="main-content">
    @if (tab == "home")
    {
      @* Основной синий блок главной страницы. *@
      <section class="hero-banner">
        <div class="hero-inner">
          <div class="hero-copy">
            <span class="hero-kicker">МАТРЕСУРС · УЧЁТ ПРЕДПРИЯТИЯ</span>
            <h1>Материальные ресурсы<br />под контролем</h1>
            <p>Удобная информационная система для учёта материалов: добавляй позиции, оформляй приход и расход, следи за остатками и формируй отчёты.</p>
            <div class="hero-actions">
              <button type="button" class="hero-primary" @onclick='() => Go("operation")'>+ Новая операция <span aria-hidden="true">→</span></button>
              <button type="button" class="hero-secondary" @onclick='() => Go("materials")'>Открыть материалы</button>
            </div>
          </div>
          <div class="hero-card">
            <div class="hero-card-icon" aria-hidden="true">▦</div>
            <h2>Почему это удобно?</h2>
            <ul>
              <li>Все материалы и остатки в одном месте</li>
              <li>История каждого поступления и расхода</li>
              <li>Проверка количества перед списанием</li>
              <li>Готовый отчёт для скачивания</li>
            </ul>
          </div>
        </div>
      </section>
    }
    <div class="content">
      @if (tab == "home")
      {
        @* Главная: показатели склада и общие остатки. *@
        <div class="section-intro"><div><h2>Склад в цифрах</h2><p>Актуальные показатели по материалам</p></div><span class="demo-label">● Демо-данные</span></div>
        <div class="stat-grid">
          <div class="stat-card"><div class="stat-icon blue">▣</div><div class="stat-label">Наименований</div><div class="stat-number">@data.Materials.Count</div><div class="stat-help">В справочнике материалов</div></div>
          <div class="stat-card"><div class="stat-icon violet">▥</div><div class="stat-label">Единиц на складе</div><div class="stat-number">@data.Materials.Sum(m => m.Quantity)</div><div class="stat-help">Текущий остаток</div></div>
          <div class="stat-card"><div class="stat-icon green">₽</div><div class="stat-label">Общая стоимость</div><div class="stat-number">@Money(TotalValue)</div><div class="stat-help">По учётным ценам</div></div>
          <div class="stat-card"><div class="stat-icon orange">!</div><div class="stat-label">Мало на складе</div><div class="stat-number">@LowCount</div><div class="stat-help">Требуют внимания</div></div>
        </div>
        @* Основные возможности системы описаны в трёх разделах. *@
        <section class="features-band" aria-label="Возможности системы">
          <div class="features-heading"><span>ВОЗМОЖНОСТИ СИСТЕМЫ</span><h2>Всё необходимое для учёта</h2></div>
          <div class="features-grid">
            <article class="feature-card"><div class="feature-symbol">▣</div><h3>Справочник материалов</h3><p>Добавление новых позиций, изменение цен и контроль минимального остатка.</p></article>
            <article class="feature-card"><div class="feature-symbol">⇄</div><h3>Приход и расход</h3><p>Регистрация движения ресурсов с автоматическим пересчётом количества.</p></article>
            <article class="feature-card"><div class="feature-symbol">▤</div><h3>Отчётность</h3><p>История операций, итоговая стоимость запасов и скачивание CSV.</p></article>
          </div>
        </section>
        <div class="panel">
          <div class="panel-title-row"><div><h2>Остатки материалов</h2><p>Актуальные сведения по всем позициям</p></div><button class="quiet-button" @onclick='() => Go("materials")'>Все материалы →</button></div>
          <MaterialTable Items="data.Materials" AllowEdit="false" />
        </div>
        <div class="hint-panel"><b>Как пользоваться?</b><span>1. Добавь материал → 2. Оформи приход или расход → 3. Посмотри остатки и отчёт.</span></div>
      }
      else if (tab == "materials")
      {
        @* Материалы: форма добавления, редактирование и поиск. *@
        <div class="page-top"><div><div class="eyebrow">СПРАВОЧНИК</div><h1>Материалы</h1><p>Добавляй материалы и отслеживай их количество.</p></div></div>
        <div class="panel form-panel"><h2>Добавить материал</h2>
          <div class="form-grid">
            <label>Название<input placeholder="Например: Бумага А4" @bind="materialName" /></label>
            <label>Единица измерения<select @bind="materialUnit"><option>шт.</option><option>пач.</option><option>кг</option><option>л</option><option>м</option><option>упак.</option></select></label>
            <label>Цена, ₽<input type="number" min="0" step="0.01" @bind="materialPrice" /></label>
            <label>Минимальный остаток<input type="number" min="0" step="1" @bind="materialMinimum" /></label>
            @* Для нового материала можно сразу указать начальное количество. *@
            <label>Количество на складе<input type="number" min="0" step="1" placeholder="0" @bind="materialInitialQuantity" /></label>
          </div>
          <div class="form-actions"><button type="button" class="primary-button" @onclick="SaveMaterial">Добавить материал</button></div>
          @if (!string.IsNullOrWhiteSpace(message)) { <div class="@MessageClass">@message</div> }
        </div>
        <div class="panel"><div class="panel-title-row"><div><h2>Список материалов</h2><p>Количество автоматически меняется после операций</p></div><input class="search" placeholder="Поиск материала..." @bind="search" @bind:event="oninput" /></div><MaterialTable Items="FilteredMaterials" AllowEdit="true" OnEdit="Edit" OnDelete="DeleteMaterial" /></div>
      }
      else if (tab == "operation")
      {
        @* Операции: приход увеличивает остаток, расход уменьшает. *@
        <div class="page-top"><div><div class="eyebrow">СКЛАДСКОЙ УЧЁТ</div><h1>Приход и расход</h1><p>Оформи поступление или выдачу со склада.</p></div></div>
        <div class="panel form-panel narrow-panel"><h2>Новая операция</h2>
          <div class="type-switch"><button class="@(operationType == "Приход" ? "active" : "")" @onclick='() => operationType = "Приход"'>↓ Приход</button><button class="@(operationType == "Расход" ? "active" : "")" @onclick='() => operationType = "Расход"'>↑ Расход</button></div>
          <div class="form-grid single">
            <label>Материал<select @bind="selectedMaterial"><option value="0">Выбери материал</option>@foreach (var item in data.Materials.OrderBy(m => m.Name)) { <option value="@item.Id">@item.Name (@item.Quantity @item.Unit)</option> }</select></label>
            <label>Количество<input type="number" min="1" step="1" @bind="operationQuantity" /></label>
            <label>Комментарий (необязательно)<input placeholder="Например: Для отдела снабжения" @bind="operationNote" /></label>
          </div>
          <button class="primary-button" @onclick="MakeOperation">Сохранить операцию</button>
          @if (!string.IsNullOrWhiteSpace(message)) { <div class="@MessageClass">@message</div> }
          <div class="inline-tip">Важно: система не позволяет списать больше, чем есть на складе.</div>
        </div>
      }
      else if (tab == "history")
      {
        @* История: журнал всех движений материалов. *@
        <div class="page-top"><div><div class="eyebrow">ЖУРНАЛ</div><h1>История операций</h1><p>Все поступления и выдачи с датой и остатком после операции.</p></div></div>
        <div class="panel"><div class="panel-title-row"><h2>Журнал движений</h2><span class="subtle">Всего записей: @data.Operations.Count</span></div>
          <div class="table-wrap"><table><thead><tr><th>Дата</th><th>Материал</th><th>Операция</th><th>Количество</th><th>Остаток</th><th>Комментарий</th></tr></thead><tbody>
            @foreach(var op in data.Operations.OrderByDescending(o => o.At).ThenByDescending(o => o.Id))
            { <tr><td>@op.At.ToString("dd.MM.yyyy HH:mm")</td><td class="strong-cell">@op.MaterialName</td><td><span class="@(op.Type == "Расход" ? "status status-expense" : "status status-income")">@op.Type</span></td><td>@op.Quantity</td><td>@op.BalanceAfter</td><td>@op.Note</td></tr> }
          </tbody></table></div>
        </div>
      }
      else if (tab == "report")
      {
        @* Отчёт: список остатков и экспорт CSV. *@
        <div class="page-top"><div><div class="eyebrow">АНАЛИТИКА</div><h1>Отчёт по остаткам</h1><p>Сводная стоимость материалов и список товаров.</p></div><button class="primary-button" @onclick="ExportReport">Скачать отчет</button></div>
        <div class="stat-grid two"><div class="stat-card"><div class="stat-icon blue">▣</div><div class="stat-label">Всего позиций</div><div class="stat-number">@data.Materials.Count</div></div><div class="stat-card"><div class="stat-icon green">₽</div><div class="stat-label">Общая стоимость</div><div class="stat-number">@Money(TotalValue)</div></div></div>
        <div class="panel"><div class="panel-title-row"><h2>Ведомость остатков</h2><span class="subtle">Дата: @DateTime.Now.ToString("dd.MM.yyyy")</span></div>
          <div class="table-wrap"><table><thead><tr><th>Наименование</th><th>Ед.</th><th>Количество</th><th>Цена</th><th>Стоимость</th></tr></thead><tbody>
            @foreach (var m in data.Materials.OrderBy(m => m.Name)) { <tr><td class="strong-cell">@m.Name</td><td>@m.Unit</td><td>@m.Quantity</td><td>@Money(m.Price)</td><td>@Money(m.Price * m.Quantity)</td></tr> }
          </tbody><tfoot><tr><td colspan="4">ИТОГО</td><td>@Money(TotalValue)</td></tr></tfoot></table></div>
        </div>
      }



      @* Авторская подпись отображается внизу любого раздела. *@
      <footer class="site-footer">
        <div class="footer-project"><strong>МатРесурс</strong><span>Информационная система учёта материальных ресурсов</span></div>
        <div class="footer-author">Выполнила: <strong>Лантух Виктория Евгеньевна</strong></div>
        <button type="button" class="footer-reset" @onclick="ResetDemo">Сбросить демонстрацию</button>
      </footer>
    </div>
  </main>


  @* Нативные диалоговые окна браузера появляются поверх страницы, независимо от прокрутки. *@
  @if (tab == "materials")
  {
    <dialog id="material-edit-dialog" class="material-native-dialog"
            style="position:fixed;inset:0;margin:auto;width:min(570px,calc(100vw - 28px));max-height:calc(100dvh - 30px);padding:0;border:0;border-radius:20px;background:transparent;"
            @onclose="OnEditDialogClosed">
      <section class="material-modal" role="document" aria-labelledby="edit-material-title">
        <div class="material-modal-heading">
          <div><span class="material-modal-kicker">СПРАВОЧНИК МАТЕРИАЛОВ</span><h2 id="edit-material-title">Изменить материал</h2><p>Измени данные и сохрани результат.</p></div>
          <button type="button" class="material-modal-close" aria-label="Закрыть окно редактирования" @onclick="CloseEdit">✕</button>
        </div>
        <div class="form-grid">
          <label>Название<input @bind="editName" /></label>
          <label>Единица измерения<select @bind="editUnit"><option>шт.</option><option>пач.</option><option>кг</option><option>л</option><option>м</option><option>упак.</option></select></label>
          <label>Цена, ₽<input type="number" min="0" step="0.01" @bind="editPrice" /></label>
          <label>Минимальный остаток<input type="number" min="0" step="1" @bind="editMinimum" /></label>
        </div>
        <p class="material-modal-tip">Количество на складе меняется через раздел «Приход и расход».</p>
        @if (!string.IsNullOrWhiteSpace(modalMessage))
        {
          <div class="message error" role="alert">@modalMessage</div>
        }
        <div class="material-modal-actions">
          <button type="button" class="outline-button" @onclick="CloseEdit">Отмена</button>
          <button type="button" class="primary-button" @onclick="SaveEditedMaterial">Сохранить изменения</button>
        </div>
      </section>
    </dialog>

    <dialog id="material-delete-dialog" class="material-native-dialog"
            style="position:fixed;inset:0;margin:auto;width:min(570px,calc(100vw - 28px));max-height:calc(100dvh - 30px);padding:0;border:0;border-radius:20px;background:transparent;"
            @onclose="OnDeleteDialogClosed">
      <section class="material-modal material-modal-delete" role="document"
               aria-labelledby="delete-material-title" aria-describedby="delete-material-description">
        <div class="material-modal-heading">
          <div><span class="material-modal-kicker danger">ПОДТВЕРЖДЕНИЕ УДАЛЕНИЯ</span><h2 id="delete-material-title">Удалить материал?</h2></div>
          <button type="button" class="material-modal-close" aria-label="Закрыть окно удаления" @onclick="CancelDelete">✕</button>
        </div>
        <p id="delete-material-description" class="material-delete-description">
          Материал <strong>«@(PendingDeleteMaterial?.Name)»</strong> будет удалён из справочника и отчётов.
          Остаток: <strong>@(PendingDeleteMaterial?.Quantity) @(PendingDeleteMaterial?.Unit)</strong>.
        </p>
        <div class="material-delete-warning">История прежних приходов и расходов сохранится.</div>
        <div class="material-modal-actions">
          <button type="button" class="outline-button" @onclick="CancelDelete">Отмена</button>
          <button type="button" class="material-confirm-delete" @onclick="ConfirmDeleteMaterial">Да, удалить</button>
        </div>
      </section>
    </dialog>
  }

</div>

@code {
    // Начальное состояние программы: учебные материалы для демонстрации.
    private InventoryData data = InventoryData.CreateDemo();
    // Какой раздел сайта сейчас открыт.
    private string tab = "home";
    // Сообщение об ошибке или успешной операции.
    private string message = "";
    // Поля формы материала, включая поиск и редактирование.
    private string search = "";
    // Открытое редактирование и подтверждение удаления показываются в модальных окнах.
    private int editId;
    private int pendingDeleteId;
    private string editName = "";
    private string editUnit = "шт.";
    private decimal editPrice;
    private int editMinimum;
    private string modalMessage = "";
    private Material? PendingDeleteMaterial => data.Materials.FirstOrDefault(m => m.Id == pendingDeleteId);
    private string materialName = "";
    private string materialUnit = "шт.";
    private decimal materialPrice;
    private int materialMinimum;
    // Количество при создании новой позиции; пустое поле означает начальный остаток 0.
    private int? materialInitialQuantity;
    // Поля формы приходной или расходной операции.
    private string operationType = "Приход";
    private int selectedMaterial;
    // Nullable int позволяет отображать действительно пустое поле после сохранения.
    private int? operationQuantity;
    private string operationNote = "";
    private bool error;
    private bool initialized;
    // Вычисляемые показатели: общая стоимость, низкий остаток, фильтрация.
    private decimal TotalValue => data.Materials.Sum(m => m.Price * m.Quantity);
    private int LowCount => data.Materials.Count(m => m.Quantity <= m.MinQuantity);
    private List<Material> FilteredMaterials => data.Materials.Where(m => m.Name.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
    private string MessageClass => error ? "message error" : "message success";
    private static string Money(decimal v) => v.ToString("N2", new CultureInfo("ru-RU")) + " ₽";

    // При первом открытии загружаем ранее сохранённые данные браузера.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await Js.InvokeAsync<string?>("matresursStorage.load");
            if (!string.IsNullOrEmpty(saved))
            {
                var loaded = JsonSerializer.Deserialize<InventoryData>(saved);
                if (loaded?.Materials != null && loaded.Operations != null) data = loaded;
            }
        }
        catch (Exception) { /* Браузер может блокировать localStorage. Демо всё равно работает. */ }
        initialized = true;
        StateHasChanged();
    }

    // Открыть выбранный раздел и очистить временные уведомления.
    private void Go(string value)
    {
        tab = value; message = ""; search = "";
        editId = 0; pendingDeleteId = 0; modalMessage = "";
    }
    // Вывести текст сообщения под формой.
    private void Notify(string value, bool isError = false) { message = value; error = isError; }
    // Сохранить изменения в localStorage. На другом компьютере данные не появятся.
    private async Task Persist()
    {
        if (!initialized) return;
        try { await Js.InvokeVoidAsync("matresursStorage.save", JsonSerializer.Serialize(data)); }
        catch (Exception) { Notify("В этом браузере сохранение запрещено. Данные доступны до обновления страницы.", true); }
    }

    // Очистить форму добавления материала.
    private void ClearMaterialForm()
    {
        materialName = ""; materialUnit = "шт."; materialPrice = 0; materialMinimum = 0;
        materialInitialQuantity = null;
    }
    // Открывает нативный модальный диалог браузера поверх всей страницы.
    private async Task Edit(Material material)
    {
        var current = data.Materials.FirstOrDefault(m => m.Id == material.Id);
        if (current == null) { Notify("Материал не найден.", true); return; }

        pendingDeleteId = 0;
        editId = current.Id;
        editName = current.Name;
        editUnit = current.Unit;
        editPrice = current.Price;
        editMinimum = current.MinQuantity;
        modalMessage = "";

        // dialog.showModal() перемещает окно в верхний слой интерфейса браузера.
        await Js.InvokeVoidAsync("matresursDialogs.show", "material-edit-dialog");
    }

    private async Task CloseEdit()
    {
        await Js.InvokeVoidAsync("matresursDialogs.close", "material-edit-dialog");
        OnEditDialogClosed();
    }

    // Срабатывает также при закрытии диалога клавишей Esc.
    private void OnEditDialogClosed()
    {
        editId = 0;
        modalMessage = "";
    }

    // Сохраняем название, цену, единицу и минимум без изменения складского остатка.
    private async Task SaveEditedMaterial()
    {
        var current = data.Materials.FirstOrDefault(m => m.Id == editId);
        if (current == null)
        {
            modalMessage = "Материал не найден. Закрой окно и обнови список.";
            return;
        }
        var name = editName.Trim();
        if (name.Length < 2)
        {
            modalMessage = "Название должно содержать минимум два символа.";
            return;
        }
        if (editPrice < 0 || editMinimum < 0)
        {
            modalMessage = "Цена и минимальный остаток не могут быть отрицательными.";
            return;
        }
        if (data.Materials.Any(m => m.Id != editId &&
            m.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            modalMessage = "Материал с таким названием уже есть.";
            return;
        }

        current.Name = name;
        current.Unit = editUnit;
        current.Price = editPrice;
        current.MinQuantity = editMinimum;
        await CloseEdit();
        Notify($"Материал «{current.Name}» успешно изменён.");
        await Persist();
    }

    // Первое нажатие «Удалить» только открывает окно подтверждения.
    private async Task DeleteMaterial(Material material)
    {
        var current = data.Materials.FirstOrDefault(m => m.Id == material.Id);
        if (current == null) { Notify("Материал не найден.", true); return; }
        editId = 0;
        modalMessage = "";
        pendingDeleteId = current.Id;
        await Js.InvokeVoidAsync("matresursDialogs.show", "material-delete-dialog");
    }

    private async Task CancelDelete()
    {
        await Js.InvokeVoidAsync("matresursDialogs.close", "material-delete-dialog");
        OnDeleteDialogClosed();
    }

    private void OnDeleteDialogClosed() => pendingDeleteId = 0;

    // Удаляем только после явного подтверждения. Журнал операций не очищаем.
    private async Task ConfirmDeleteMaterial()
    {
        int id = pendingDeleteId;
        await CancelDelete();
        var current = data.Materials.FirstOrDefault(m => m.Id == id);
        if (current == null) { Notify("Материал уже удалён или не найден.", true); return; }

        data.Materials.Remove(current);
        if (selectedMaterial == id) selectedMaterial = 0;

        Notify($"Материал «{current.Name}» удалён. История операций сохранена.");
        await Persist();
    }

    // Добавить новую позицию и зафиксировать начальный остаток в истории.
    private async Task SaveMaterial()
    {
        string name = materialName.Trim();
        if (name.Length < 2) { Notify("Укажи название материала (не менее двух символов).", true); return; }
        if (materialPrice < 0 || materialMinimum < 0) { Notify("Цена и минимальный остаток не могут быть отрицательными.", true); return; }
        if (materialInitialQuantity < 0) { Notify("Начальное количество не может быть отрицательным.", true); return; }
        if (data.Materials.Any(m => m.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        { Notify("Такой материал уже существует.", true); return; }

        int startQuantity = materialInitialQuantity ?? 0;
        data.Materials.Add(new Material { Id = data.NextMaterialId++, Name = name,
            Unit = materialUnit, Price = materialPrice, MinQuantity = materialMinimum, Quantity = startQuantity });
        if (startQuantity > 0)
        {
            data.Operations.Add(new StockOperation { Id = data.NextOperationId++,
                At = DateTime.Now, MaterialName = name, Type = "Начальный остаток",
                Quantity = startQuantity, BalanceAfter = startQuantity, Note = "Добавление материала" });
        }
        ClearMaterialForm();
        Notify("Материал добавлен. Начальное количество сохранено.");
        await Persist();
    }

    // Изменить остаток и добавить строку в журнал операций.
    private async Task MakeOperation()
    {
        var item = data.Materials.FirstOrDefault(m => m.Id == selectedMaterial);
        if (item == null) { Notify("Сначала выбери материал.", true); return; }
        if (!operationQuantity.HasValue || operationQuantity.Value <= 0)
        { Notify("Укажи количество больше нуля.", true); return; }
        int quantity = operationQuantity.Value;
        if (operationType == "Расход" && quantity > item.Quantity)
        { Notify($"Недостаточно материала на складе: доступно {item.Quantity} {item.Unit}.", true); return; }
        try { item.Quantity = checked(item.Quantity + (operationType == "Приход" ? quantity : -quantity)); }
        catch (OverflowException) { Notify("Слишком большое количество.", true); return; }
        data.Operations.Add(new StockOperation { Id = data.NextOperationId++, At = DateTime.Now,
            MaterialName = item.Name, Type = operationType, Quantity = quantity,
            BalanceAfter = item.Quantity, Note = operationNote.Trim() });
        Notify($"Готово! {operationType}: {quantity} {item.Unit}. Остаток: {item.Quantity}.");
        // После успешного сохранения все поля ввода очищаются для следующей операции.
        selectedMaterial = 0;
        operationQuantity = null;
        operationNote = "";
        await Persist();
    }
    // С согласия пользователя восстановить учебные данные.
    private async Task ResetDemo()
    {
        if (!await Js.InvokeAsync<bool>("matresursStorage.askReset")) return;
        data = InventoryData.CreateDemo(); ClearMaterialForm();
        selectedMaterial = 0; operationQuantity = null; operationNote = ""; message = "";
        await Persist(); Go("home");
    }

    // Корректно оформить текст с кавычками для формата CSV.
    private static string Csv(string s) => "\"" + s.Replace("\"", "\"\"") + "\"";
    // Составить отчёт об остатках и скачать CSV-файл.
    private async Task ExportReport()
    {
        var csv = new StringBuilder("Наименование;Единица;Количество;Цена;Стоимость\r\n");
        foreach (var m in data.Materials.OrderBy(m => m.Name))
            csv.AppendLine($"{Csv(m.Name)};{Csv(m.Unit)};{m.Quantity};{m.Price.ToString(CultureInfo.InvariantCulture)};{(m.Price * m.Quantity).ToString(CultureInfo.InvariantCulture)}");
        csv.AppendLine($"ИТОГО;;;;{TotalValue.ToString(CultureInfo.InvariantCulture)}");
        await Js.InvokeVoidAsync("matresursStorage.download", "ostatki-matresurs.csv", "\ufeff" + csv.ToString());
    }
}
